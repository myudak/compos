# Browser apps
# Kosongkan VITE_API_URL pada hosted same-origin build.
VITE_API_URL=http://localhost:3001

# Local NestJS API (canonical config tinggal di ../k-pos-be/.env.example)
PORT=3001
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:8080
DATABASE_URL=postgresql://postgres:kpos-secret@localhost:5432/kpos_db?schema=public
DIRECT_URL=postgresql://postgres:kpos-secret@localhost:5432/kpos_db?schema=public
DATABASE_SSL=false
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_PREFETCH=10
JWT_SECRET=change-this-outside-local-demo
OFFLINE_LEASE_SECRET=change-this-too-outside-local-demo
JWT_EXPIRATION_TIME=15m
OFFLINE_LEASE_TTL=7d

# Demo seed credentials dibuat oleh backend seed:
# owner@kedai-nusa.test / owner123
# entry@kedai-nusa.test / entry123
# operator@kedai-nusa.test / operator123 / device KPOS-DEMO-DEVICE
