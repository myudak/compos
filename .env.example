# Frontend
VITE_API_URL=http://localhost:3001
VITE_DEMO_MODE=false

# API
DATABASE_URL=postgres://operator:operator@localhost:5432/operator_pos
PORT=3001
HOST=0.0.0.0
JWT_SECRET=change-this-before-production
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:4173,http://127.0.0.1:4173,http://localhost:4174,http://127.0.0.1:4174,https://compos.myudak.com
DEVICE_ACTIVATION_CODE=COMPOS-DEMO
DEMO_MERCHANT_CODE=KEDAI-NUSA

# Hosted demo packaging. Keep false for the normal Vite + Fastify development setup.
SERVE_WEB=false
# WEB_DIST_PATH defaults to apps/operator-web/dist resolved from the API module.
# OWNER_WEB_DIST_PATH defaults to apps/owner-web/dist.

# PostgreSQL workload budgets. Total per API replica = operational + admin + reporting.
OPERATIONAL_DB_POOL_MAX=12
ADMIN_DB_POOL_MAX=4
REPORTING_DB_POOL_MAX=4
WORKER_DB_POOL_MAX=4

# Optional OpenAI-compatible provider. Tanpa secret, insight memakai deterministic local analytics.
# AI_INSIGHT_BASE_URL=https://api.example.com/v1/
# AI_INSIGHT_API_KEY=
AI_INSIGHT_MODEL=gpt-4.1-mini
AI_INSIGHT_TIMEOUT_MS=15000
