{
  "name": "@k-pos/api-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "vitest run",
    "generate": "openapi-typescript openapi.json -o src/generated/schema.d.ts"
  },
  "dependencies": {
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "openapi-typescript": "^7.9.1",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  }
}
