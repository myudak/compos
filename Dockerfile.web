# syntax=docker/dockerfile:1.7
FROM node:22-alpine AS builder

WORKDIR /workspace
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/operator-web/package.json ./apps/operator-web/package.json
COPY apps/entry-web/package.json ./apps/entry-web/package.json
COPY apps/owner-web/package.json ./apps/owner-web/package.json
COPY packages/api-client/package.json ./packages/api-client/package.json
RUN --mount=type=cache,id=kpos-frontend-pnpm,target=/pnpm/store \
  pnpm config set store-dir /pnpm/store \
  && pnpm install --frozen-lockfile

COPY . .
RUN pnpm --filter @k-pos/api-client build \
  && pnpm --filter @k-pos/operator-web build \
  && pnpm --filter @k-pos/entry-web build \
  && pnpm --filter @k-pos/owner-web build

FROM nginx:1.27-alpine

COPY deployment/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /workspace/apps/operator-web/dist /usr/share/nginx/html
COPY --from=builder /workspace/apps/entry-web/dist /usr/share/nginx/html/entry
COPY --from=builder /workspace/apps/owner-web/dist /usr/share/nginx/html/owner

EXPOSE 80
