{
  "name": "operator-pos-monorepo",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "pnpm contracts:build && concurrently --kill-others-on-fail --names web,api,worker --prefix-colors cyan,magenta,yellow \"pnpm dev:web\" \"pnpm dev:api\" \"pnpm worker\"",
    "contracts:build": "pnpm --filter @operator/contracts build",
    "dev:web": "pnpm --filter @operator/web dev",
    "dev:api": "pnpm --filter @operator/api dev",
    "worker": "pnpm --filter @operator/api worker",
    "build": "pnpm -r --if-present build",
    "build:web": "pnpm --filter @operator/web build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm contracts:build && pnpm -r --if-present test",
    "test:integration": "pnpm contracts:build && pnpm --filter @operator/api test:integration",
    "test:e2e": "pnpm --filter @operator/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm build && pnpm test:e2e",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:reset": "pnpm --filter @operator/api db:reset",
    "db:migrate": "pnpm --filter @operator/api db:migrate",
    "db:seed": "pnpm --filter @operator/api db:seed",
    "preview": "pnpm --filter @operator/web preview"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.33.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1"
  }
}
