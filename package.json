{
  "name": "operator-pos-monorepo",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "pnpm contracts:build && concurrently --kill-others-on-fail --names operator,owner,api,worker --prefix-colors cyan,blue,magenta,yellow \"pnpm dev:web\" \"pnpm dev:owner\" \"pnpm dev:api\" \"pnpm worker\"",
    "contracts:build": "pnpm --filter @operator/contracts build",
    "dev:web": "pnpm --filter @operator/web dev",
    "dev:owner": "pnpm --filter @operator/owner-web dev",
    "dev:api": "pnpm --filter @operator/api dev",
    "worker": "pnpm --filter @operator/api worker",
    "build": "pnpm -r --if-present build",
    "build:web": "pnpm --filter @operator/web build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "test": "pnpm contracts:build && pnpm -r --if-present test",
    "test:integration": "pnpm contracts:build && pnpm --filter @operator/api test:integration",
    "test:e2e": "pnpm --filter @operator/web test:e2e",
    "test:load": "pnpm --filter @operator/api test:load",
    "test:load:500": "pnpm --filter @operator/api test:load:500",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "docs:check": "node scripts/check-markdown-links.mjs",
    "ci": "pnpm format:check && pnpm docs:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm build && pnpm test:load && pnpm test:e2e",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:reset": "pnpm --filter @operator/api db:reset",
    "db:migrate": "pnpm --filter @operator/api db:migrate",
    "db:seed": "pnpm --filter @operator/api db:seed",
    "db:seed:built": "node apps/api/dist/scripts/seed.js",
    "start:hosted": "node apps/api/dist/scripts/migrate.js && node apps/api/dist/server.js",
    "worker:hosted": "node apps/api/dist/scripts/migrate.js && node apps/api/dist/worker-entry.js",
    "preview": "pnpm --filter @operator/web preview"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "~5.8.3"
  }
}
