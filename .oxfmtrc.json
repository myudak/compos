{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 100,
  "sortPackageJson": false,
  "ignorePatterns": [
    ".agents/",
    ".claude/",
    ".pnpm-store/",
    "dist/",
    "coverage/",
    "playwright-report/",
    "test-results/",
    "pnpm-lock.yaml"
  ]
}
