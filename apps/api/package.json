{
  "name": "@operator/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "start": "node dist/server.js",
    "worker": "tsx src/worker-entry.ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "owner:provision": "tsx src/scripts/provision-owner.ts",
    "db:reset": "tsx src/scripts/reset.ts && pnpm db:migrate && pnpm db:seed",
    "smoke": "tsx src/scripts/smoke.ts",
    "test:integration": "tsx src/scripts/integration-runner.ts",
    "test:load": "tsx src/scripts/load-harness.ts --merchants=50 --duration=15",
    "test:load:500": "tsx src/scripts/load-harness.ts --merchants=500 --duration=300",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@operator/contracts": "workspace:*",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.1",
    "fastify": "^5.5.0",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.4",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  }
}
